# Backend Configuration
# Set to 'local' or 'firebase'
EXPO_PUBLIC_BACKEND_TYPE=local

# LLM Configuration (for chat feature)
# Only configure the provider(s) you want to use.
# Note: These keys are exposed to the client. Consider using a backend proxy in production.

# OpenAI - Get your API key from https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=

# Anthropic (Claude) - Get your API key from https://console.anthropic.com/
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Google (Gemini) - Get your API key from https://aistudio.google.com/apikey
EXPO_PUBLIC_GOOGLE_API_KEY=

# Firebase Configuration (only needed if BACKEND_TYPE=firebase)
# Get these values from Firebase Console → Project Settings → Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
