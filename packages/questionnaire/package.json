{
  "name": "@spezivibe/questionnaire",
  "version": "1.0.0",
  "description": "A reusable React Native questionnaire component library",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "react-native",
    "questionnaire",
    "survey",
    "form",
    "spezi"
  ],
  "author": "SpeziVibe",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "formik": "^2.4.0",
    "yup": "^1.0.0",
    "react-native-ui-datepicker": "^3.1.2"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "react-native-ui-datepicker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.11",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^18.0.7",
    "jest": "^29.7.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|formik)/)"
    ],
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx"],
    "testMatch": ["**/__tests__/**/*.test.ts?(x)"]
  }
}
