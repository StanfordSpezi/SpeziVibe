{
  "name": "Questionnaire",
  "category": "feature",
  "platform": "swift",
  "description": "FHIR-compliant health questionnaires via SpeziQuestionnaire",
  "spmPackages": {
    "SpeziQuestionnaire": {
      "url": "https://github.com/StanfordSpezi/SpeziQuestionnaire.git",
      "from": "1.3.0",
      "products": [
        "SpeziQuestionnaire"
      ]
    },
    "ResearchKitOnFHIR": {
      "url": "https://github.com/StanfordBDHG/ResearchKitOnFHIR.git",
      "from": "2.0.0",
      "products": [
        "FHIRQuestionnaires"
      ]
    }
  },
  "targetDependencies": [
    "SpeziQuestionnaire",
    "FHIRQuestionnaires"
  ],
  "copyFiles": [
    "Questionnaires/SampleQuestionnaire.json",
    "Questionnaires/Bundle+Questionnaire.swift"
  ],
  "standardImports": [
    "SpeziQuestionnaire"
  ],
  "standardMethods": "func add(\n        response: ModelsR4.QuestionnaireResponse,\n        for questionnaire: ModelsR4.Questionnaire\n    ) async {\n        let responseId = response.identifier?.value?.value?.string ?? UUID().uuidString\n        logger.debug(\"Received questionnaire response: \\(responseId)\")\n    }",
  "requires": [
    "scheduler"
  ]
}